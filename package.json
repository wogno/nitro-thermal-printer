{
  "name": "react-native-thermal-receipt-printer-image-qr",
  "version": "3.0.0",
  "description": "High-performance React Native library for thermal receipt printers (USB/BLE/Net) using Nitro Modules",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "scripts": {
    "pods": "cd example && pod-install --quiet",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn && yarn pods",
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "codegen": "nitro-codegen",
    "prepare": "bob build",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "TODO: Add your repository URL here"
  },
  "files": [
    "src",
    "lib",
    "nitrogen",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "nitro.json",
    "!ios/build",
    "!android/build",
    "!android/.gradle",
    "!**/__tests__",
    "!**/*.spec.ts"
  ],
  "keywords": [
    "react-native",
    "thermal",
    "printer",
    "bluetooth",
    "ble",
    "net",
    "usb",
    "nitro",
    "jsi",
    "android",
    "ios",
    "image",
    "qr",
    "base64",
    "receipt",
    "bill",
    "invoice",
    "escpos"
  ],
  "dependencies": {
    "buffer": "^6.0.3",
    "iconv-lite": "^0.6.3",
    "react-native-nitro-modules": "^0.18.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.0",
    "eslint": "^8.50.0",
    "nitro-codegen": "^0.18.2",
    "react": "^18.2.0",
    "react-native": "^0.76.0",
    "react-native-builder-bob": "^0.23.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0",
    "react-native-nitro-modules": ">=0.18.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "thiendangit",
  "homepage": "https://github.com/thiendangit/react-native-thermal-receipt-printer-image-qr#readme",
  "license": "MIT",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      ["typescript", { "project": "tsconfig.build.json" }]
    ]
  },
  "codegenConfig": {
    "name": "NitroThermalPrinterSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs"
  }
}

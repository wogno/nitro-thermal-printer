{
  "name": "react-native-thermal-receipt-printer-image-qr",
  "version": "3.0.3",
  "description": "High-performance React Native library for thermal receipt printers (USB/BLE/Net) using Nitro Modules",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "scripts": {
    "pods": "cd example && pod-install --quiet",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn && yarn pods",
    "build": "bob build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "codegen": "nitrogen",
    "prepare": "bob build",
    "release": "release-it",
    "watch": "./scripts/watch-and-build.sh",
    "rebuild": "yarn codegen && yarn build",
    "sync:erp": "./scripts/sync-to-erp.sh"
  },
  "repository": {
    "type": "git",
    "url": "TODO: Add your repository URL here"
  },
  "files": [
    "src",
    "lib",
    "nitrogen",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "nitro.json",
    "react-native.config.js",
    "!ios/build",
    "!android/build",
    "!android/.gradle",
    "!**/__tests__",
    "!**/*.spec.ts"
  ],
  "keywords": [
    "react-native",
    "thermal",
    "printer",
    "bluetooth",
    "ble",
    "net",
    "usb",
    "nitro",
    "jsi",
    "android",
    "ios",
    "image",
    "qr",
    "base64",
    "receipt",
    "bill",
    "invoice",
    "escpos"
  ],
  "dependencies": {
    "buffer": "^6.0.3",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "eslint": "^8.50.0",
    "nitrogen": "^0.32.0",
    "react": "^19.1.0",
    "react-native": "^0.80.0",
    "react-native-builder-bob": "^0.40.17",
    "react-native-nitro-modules": "^0.32.0",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.80.0",
    "react-native-nitro-modules": ">=0.32.0",
    "react-native-ping": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": false
    }
  },
  "reactNativeManifest": {
    "architectures": {
      "new": true,
      "old": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "author": "thiendangit",
  "homepage": "https://github.com/thiendangit/react-native-thermal-receipt-printer-image-qr#readme",
  "license": "MIT",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "NitroThermalPrinterSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs"
  }
}
